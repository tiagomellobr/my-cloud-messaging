# =============================================
# Database
# =============================================
# DATABASE_URL: usado ao rodar a app FORA do Docker (aponta para a porta de host).
# Dentro do Docker o app usa o DATABASE_URL do docker-compose.yml (db:5432 interno).
DATABASE_URL=postgres://mcm:change_me_in_production@localhost:5432/cloud_messaging
POSTGRES_DB=cloud_messaging
POSTGRES_USER=mcm
POSTGRES_PASSWORD=change_me_in_production
# Porta de host para acessar o banco de fora do container
POSTGRES_PORT=5432

# =============================================
# Server
# =============================================
HOST=0.0.0.0
# Porta de host para acessar o app de fora do container
PORT=8080

# =============================================
# Security
# =============================================
# Bearer token required on all protected endpoints
# Generate with: openssl rand -hex 32
API_KEY=change_me_in_production

# =============================================
# VAPID
# =============================================
# Contact email shown to push services (required by spec)
VAPID_CONTACT=mailto:admin@example.com

# =============================================
# Behavior
# =============================================
RUST_LOG=info,sqlx=warn
CLEANUP_INTERVAL_HOURS=6
NOTIFICATION_TTL_SECONDS=86400
